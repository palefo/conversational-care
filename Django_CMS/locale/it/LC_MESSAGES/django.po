#: ConvAI/models.py:485
msgid ""
"Remote = runs on a LangGraph server (host:port). Native = ships with the "
"platform. Prompt-based = in-process agent driven by a stored prompt."
msgstr ""
"Remoto = eseguito su un server LangGraph (host:porta). Nativo = fornito con "
"la piattaforma. Basato su prompt = agente in-process guidato da un prompt "
"memorizzato."

