msgid ""
"System prompt for prompt-based agents. Used as the system message on every "
"turn."
msgstr ""
"Prompt di sistema per gli agenti basati su prompt. Usato come messaggio di "
"sistema a ogni turno."

#: ConvAI/models.py:508
msgid ""
"Prompt-based agents only: chat through the real-time voice API (live speech "
"in/out) instead of the text chat."
msgstr ""
"Solo agenti basati su prompt: conversa tramite l'API vocale in tempo reale "
"(voce dal vivo in ingresso e uscita) invece della chat testuale."

