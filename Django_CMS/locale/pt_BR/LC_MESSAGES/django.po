#: ConvAI/models.py:485
msgid ""
"Remote = runs on a LangGraph server (host:port). Native = ships with the "
"platform. Prompt-based = in-process agent driven by a stored prompt."
msgstr ""
"Remoto = executado em um servidor LangGraph (host:porta). Nativo = acompanha"
" a plataforma. Baseado em prompt = agente em processo guiado por um prompt "
"armazenado."

