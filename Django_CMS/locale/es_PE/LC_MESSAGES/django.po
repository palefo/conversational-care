#: ConvAI/models.py:485
msgid ""
"Remote = runs on a LangGraph server (host:port). Native = ships with the "
"platform. Prompt-based = in-process agent driven by a stored prompt."
msgstr ""
"Remoto = se ejecuta en un servidor LangGraph (host:puerto). Nativo = viene "
"con la plataforma. Basado en prompt = agente en proceso guiado por un prompt"
" almacenado."

