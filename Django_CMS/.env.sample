# Host port that publishes the app (docker-compose). Change it when this
# machine already has something on 8000 — e.g. a second copy of the project.
WEB_PUBLISH_PORT=8000

# Platform UI language: English, Spanish, Portuguese, Italian, Korean or Chinese.
PLATFORM_LANG="English"
PLATFORM_TZ="Europe/London"
# REQUIRED in production: Django signing key. Generate one with
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# Optional dedicated key for signing single-use media download tokens.
# Falls back to a random per-process key when unset (tokens then expire on restart).
DOWNLOAD_TOKEN_KEY=
# Allowed hosts (comma-separated). Dev default is localhost/127.0.0.1/0.0.0.0.
# Example prod: ALLOWED_HOSTS=example.com,www.example.com,platform.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# CSRF trusted origins (comma-separated, must include scheme).
# Example: CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=
# Local dev: enable DEBUG so runserver serves /static/. Keep 0 (or unset) in production.
DJANGO_DEBUG=1
BRAND_LOGO=app/images/conversational-care_logo.png
BRAND_NAME=conversational-care.ai
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PLATFORM_PHONE=
# Inbound Twilio webhook path (no leading/trailing slash). Default: webhooks/whatsapp
TWILIO_WEBHOOK_PATH=webhooks/whatsapp
# Expose the REST API (/api/v1/...). Set to 0 to disable it entirely.
ENABLE_API=1
# --- Agent models (see agents.md) ---
# Default model for in-process agents when an agent has no explicit model set.
# May be provider-prefixed: openai/… anthropic/… google/… mistral/… deepseek/…
DEFAULT_AGENT_MODEL=openai/gpt-4.1-mini
# Provider API keys — only the providers you actually use are required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# --- Azure (optional): route models to Azure instead of the public APIs ---
USE_AZURE=false
# Azure OpenAI (openai/gpt models). Under USE_AZURE the model string is the Azure DEPLOYMENT name.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Azure Anthropic (claude models)
AZURE_ANTHROPIC_ENDPOINT=
AZURE_ANTHROPIC_API_KEY=
# Azure Mistral (OpenAI-compatible endpoint)
AZURE_MISTRAL_ENDPOINT=
AZURE_MISTRAL_API_KEY=
# Azure DeepSeek (OpenAI-compatible; leave blank to reuse the Mistral endpoint/key)
AZURE_DEEPSEEK_ENDPOINT=
AZURE_DEEPSEEK_API_KEY=
# Azure OpenAI Realtime — speech-to-speech voice for prompt-based agents with
# "Real-time voice agent" enabled. Endpoint/key blank reuse AZURE_OPENAI_*.
AZURE_REALTIME_ENDPOINT=
AZURE_REALTIME_API_KEY=
AZURE_REALTIME_DEPLOYMENT=gpt-realtime
AZURE_REALTIME_VOICE=marin
# Only for resources that expose just the *preview* Realtime API (the GA v1
# surface 404s): the resource's region for the WebRTC gateway.
AZURE_REALTIME_WEBRTC_REGION=
# Azure deployment serving the embedding model below. Blank reuses the model
# name, and the endpoint/key come from AZURE_OPENAI_* above.
AZURE_EMBEDDING_DEPLOYMENT=

# --- RAG-based prompt agents (see agents.md) ---
# Embedding model used to index and search uploaded documents. Multilingual:
# a question in one language finds answers in documents written in another.
# Changing it makes existing documents unsearchable until they are re-uploaded.
RAG_EMBEDDING_MODEL=text-embedding-3-small
# Background worker threads that read, chunk and embed uploaded documents.
# Separate from WHATSAPP_WORKERS so a long upload cannot delay a reply.
RAG_WORKERS=2

ELEVENLABS_API_KEY=
# Private media directories. Leave unset to derive them from MEDIA_ROOT (the
# persistent /media volume): media/voice and media/call_recordings. Only set
# these to relocate storage. See file_storage.md.
# VOICE_RECORDINGS_DIR=/media/voice
# CALL_RECORDINGS_DIR=/media/call_recordings
HIDE_MEETING_STEPS=1
ENABLE_AUTOMATIONS=1

# Self-registration agent settings
SELF_REGISTRATION_ENABLED=0
SELF_REG_AGENT_NAME="agent_name"

#Alerting system
TWILIO_SMS_FROM=""
SMS_TEMPLATE_START_INFECTION_SID=""
SMS_TEMPLATE_START_INFECTION_TEXT=""

#File sending
SEND_CARE_PLAN=0
WHATSAPP_TEMPLATE_CARE_PLAN_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Twilio Content API template used for meeting reminders (ContentSid).
WHATSAPP_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Outbound email (see email.md) ---
# Which provider carries mail the platform sends — password-reset links, meeting
# reminders, the test message. 'azure' or 'smtp'; blank disables sending.
# Everything here can also be set in Settings -> Email, which overrides .env and
# takes effect without a restart.
EMAIL_PROVIDER=
# The address mail is sent from. Must be a verified sender on the provider's
# domain. Also used as Django's DEFAULT_FROM_EMAIL.
EMAIL_FROM=
# Display name beside the sender address. Blank uses BRAND_NAME. Azure ignores
# it — its display name comes from the sender username set on the domain.
EMAIL_FROM_NAME=
# Where replies go, if anywhere. Comma-separated for more than one.
EMAIL_REPLY_TO=

# Azure Communication Services Email. Either paste the whole connection string,
# or give the endpoint and access key and let the platform assemble one.
#   AZURE_EMAIL_CONNECTION_STRING=endpoint=https://<resource>.uk.communication.azure.com/;accesskey=<key>
AZURE_EMAIL_CONNECTION_STRING=
AZURE_EMAIL_ENDPOINT=
AZURE_EMAIL_ACCESS_KEY=

# SMTP. Port blank uses 587 for STARTTLS and 465 for SSL/TLS.
# SMTP_SECURITY is tls (STARTTLS), ssl, or none; blank means tls.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=tls

# How long a password-reset link stays valid, in seconds. Default 3 hours.
PASSWORD_RESET_TIMEOUT=10800

# Channel the "Send reminder" button uses for a scheduled meeting: whatsapp or
# email. Email goes to the caregiver's address, falling back to the client's,
# and needs a working provider above.
REMINDER_CHANNEL=whatsapp

#Agents and interaction
WHATSAPP_AUDIO_ENABLED=0
ELEVENLABS_VOICE_ID=""

# Database settings — how the app CONNECTS to Postgres. See database.md.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=djangocms_db
DB_USER=djangocms_user
DB_PASSWORD=djangocms_pass
DB_HOST=db          # 'db' = the bundled container; a hostname/IP for an external Postgres
DB_PORT=5432        # port the app connects to (inside the Docker network for the bundled DB)
DB_SSLMODE=disable  # 'disable' for a plain local DB; 'require' for managed DBs (e.g. Supabase)

# Host port that EXPOSES the bundled Postgres to the machine (docker-compose only).
# Change this if the host's 5432 is already used by another database. This does
# NOT change DB_PORT above — the app still reaches the bundled DB on 5432 internally.
POSTGRES_PUBLISH_PORT=5432

# Async WhatsApp/SMS reply handling (self-contained, no external broker).
# When enabled, replies are generated on an in-process worker pool so the Twilio
# webhook returns immediately. See async_replies.md.
ASYNC_WHATSAPP_REPLY=0
# Number of background worker threads for async replies.
WHATSAPP_WORKERS=2

# Allow-list of hosts a remote agent may point at (SSRF guard; host only, no port).
# Use `host.docker.internal` to reach an agent published on the HOST machine when
# the app runs in Docker (e.g. an agent container exposed on the host at :8123).
AGENT_ALLOWED_HOSTS=host.docker.internal,localhost,127.0.0.1
