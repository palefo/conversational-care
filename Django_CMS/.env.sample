# Host port that publishes the app (docker-compose). Change it when this
# machine already has something on 8000 — e.g. a second copy of the project.
WEB_PUBLISH_PORT=8000

# Platform UI language: English, Spanish, Portuguese, Italian, Korean or Chinese.
PLATFORM_LANG="English"
PLATFORM_TZ="Europe/London"
# REQUIRED in production: Django signing key. Generate one with
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# Optional dedicated key for signing single-use media download tokens.
# Falls back to a random per-process key when unset (tokens then expire on restart).
DOWNLOAD_TOKEN_KEY=
# Allowed hosts (comma-separated). Dev default is localhost/127.0.0.1/0.0.0.0.
# Example prod: ALLOWED_HOSTS=example.com,www.example.com,platform.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# CSRF trusted origins (comma-separated, must include scheme).
# Example: CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=
# Local dev: enable DEBUG so runserver serves /static/. Keep 0 (or unset) in production.
DJANGO_DEBUG=1
BRAND_LOGO=app/images/conversational-care_logo.png
BRAND_NAME=conversational-care.ai
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PLATFORM_PHONE=
# Inbound Twilio webhook path (no leading/trailing slash). Default: webhooks/whatsapp
TWILIO_WEBHOOK_PATH=webhooks/whatsapp
# Expose the REST API (/api/v1/...). Set to 0 to disable it entirely.
ENABLE_API=1
# --- Agent models (see agents.md) ---
# Default model for in-process agents when an agent has no explicit model set.
# May be provider-prefixed: openai/… anthropic/… google/… mistral/… deepseek/…
DEFAULT_AGENT_MODEL=openai/gpt-4.1-mini
# Model for automatic summaries and the safety review (conversations, meetings,
# call transcripts). Blank: each agent's model, then DEFAULT_AGENT_MODEL. Also in
# Settings → Agents. Under Azure, its content filter must not block self-harm at
# Medium, or those conversations go unreviewed.
SUMMARY_MODEL=
# Provider API keys — only the providers you actually use are required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# --- Azure (optional): route models to Azure instead of the public APIs ---
USE_AZURE=false
# Azure OpenAI (openai/gpt models). Under USE_AZURE the model string is the Azure DEPLOYMENT name.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Azure Anthropic (claude models)
AZURE_ANTHROPIC_ENDPOINT=
AZURE_ANTHROPIC_API_KEY=
# Azure Mistral (OpenAI-compatible endpoint)
AZURE_MISTRAL_ENDPOINT=
AZURE_MISTRAL_API_KEY=
# Azure DeepSeek (OpenAI-compatible; leave blank to reuse the Mistral endpoint/key)
AZURE_DEEPSEEK_ENDPOINT=
AZURE_DEEPSEEK_API_KEY=
# Azure OpenAI Realtime — speech-to-speech voice for prompt-based agents with
# "Real-time voice agent" enabled. Endpoint/key blank reuse AZURE_OPENAI_*.
AZURE_REALTIME_ENDPOINT=
AZURE_REALTIME_API_KEY=
AZURE_REALTIME_DEPLOYMENT=gpt-realtime
AZURE_REALTIME_VOICE=marin
# Only for resources that expose just the *preview* Realtime API (the GA v1
# surface 404s): the resource's region for the WebRTC gateway.
AZURE_REALTIME_WEBRTC_REGION=
# Azure deployment serving the embedding model below. Blank reuses the model
# name, and the endpoint/key come from AZURE_OPENAI_* above.
AZURE_EMBEDDING_DEPLOYMENT=

# --- RAG-based prompt agents (see agents.md) ---
# Embedding model used to index and search uploaded documents. Multilingual:
# a question in one language finds answers in documents written in another.
# Changing it makes existing documents unsearchable until they are re-uploaded.
RAG_EMBEDDING_MODEL=text-embedding-3-small
# Background worker threads that read, chunk and embed uploaded documents.
# Separate from WHATSAPP_WORKERS so a long upload cannot delay a reply.
RAG_WORKERS=2

ELEVENLABS_API_KEY=
# Private media directories. Leave unset to derive them from MEDIA_ROOT (the
# persistent /media volume): media/voice and media/call_recordings. Only set
# these to relocate storage. See file_storage.md.
# VOICE_RECORDINGS_DIR=/media/voice
# CALL_RECORDINGS_DIR=/media/call_recordings
HIDE_MEETING_STEPS=1
ENABLE_AUTOMATIONS=1
# Phone calls through Twilio. On unless set to 0. Off: nothing offers a call,
# new meetings default to in person, and the call endpoints refuse. For an
# installation that only meets people in person (or online). Also in
# Settings → General, which overrides this.
PHONE_CALLS_ENABLED=1

# Self-registration agent settings
SELF_REGISTRATION_ENABLED=0
SELF_REG_AGENT_NAME="agent_name"

#Alerting system
TWILIO_SMS_FROM=""
SMS_TEMPLATE_START_INFECTION_SID=""
SMS_TEMPLATE_START_INFECTION_TEXT=""

#File sending
SEND_CARE_PLAN=0
WHATSAPP_TEMPLATE_CARE_PLAN_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Twilio Content API template used for meeting reminders (ContentSid).
WHATSAPP_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Outbound email (see email.md) ---
# Which provider carries mail the platform sends — password-reset links, meeting
# reminders, the test message. 'azure' or 'smtp'; blank disables sending.
# Everything here can also be set in Settings -> Email, which overrides .env and
# takes effect without a restart.
EMAIL_PROVIDER=
# The address mail is sent from. Must be a verified sender on the provider's
# domain. Also used as Django's DEFAULT_FROM_EMAIL.
EMAIL_FROM=
# Display name beside the sender address. Blank uses BRAND_NAME. Azure ignores
# it — its display name comes from the sender username set on the domain.
EMAIL_FROM_NAME=
# Where replies go, if anywhere. Comma-separated for more than one.
EMAIL_REPLY_TO=

# Azure Communication Services Email. Either paste the whole connection string,
# or give the endpoint and access key and let the platform assemble one.
#   AZURE_EMAIL_CONNECTION_STRING=endpoint=https://<resource>.uk.communication.azure.com/;accesskey=<key>
AZURE_EMAIL_CONNECTION_STRING=
AZURE_EMAIL_ENDPOINT=
AZURE_EMAIL_ACCESS_KEY=

# SMTP. Port blank uses 587 for STARTTLS and 465 for SSL/TLS.
# SMTP_SECURITY is tls (STARTTLS), ssl, or none; blank means tls.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=tls

# How long a password-reset link stays valid, in seconds. Default 3 hours.
PASSWORD_RESET_TIMEOUT=10800

# Channel the "Send reminder" button uses for a scheduled meeting: whatsapp or
# email. Email goes to the caregiver's address, falling back to the client's,
# and needs a working provider above.
REMINDER_CHANNEL=whatsapp

#Agents and interaction
WHATSAPP_AUDIO_ENABLED=0
ELEVENLABS_VOICE_ID=""

# --- Text to speech (see text_to_speech.md) ---
# Who speaks every voice reply: elevenlabs (the default when unset) or azure.
# Also in Settings → Agents → Text to speech, which overrides these.
TTS_PROVIDER=elevenlabs
# Azure AI Speech: a Speech resource's key and region, from Keys and Endpoint in
# the Azure portal (region like uksouth; the endpoint URL is not needed).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Voice for agents with no Azure voice of their own (blank:
# en-GB-AdaMultilingualNeural, which speaks the reply's language).
AZURE_SPEECH_VOICE=

# Database settings — how the app CONNECTS to Postgres. See database.md.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=djangocms_db
DB_USER=djangocms_user
DB_PASSWORD=djangocms_pass
DB_HOST=db          # 'db' = the bundled container; a hostname/IP for an external Postgres
DB_PORT=5432        # port the app connects to (inside the Docker network for the bundled DB)
DB_SSLMODE=disable  # 'disable' for a plain local DB; 'require' for managed DBs (e.g. Supabase)

# Host port that EXPOSES the bundled Postgres to the machine (docker-compose only).
# Change this if the host's 5432 is already used by another database. This does
# NOT change DB_PORT above — the app still reaches the bundled DB on 5432 internally.
POSTGRES_PUBLISH_PORT=5432

# Async WhatsApp/SMS reply handling (self-contained, no external broker).
# When enabled, replies are generated on an in-process worker pool so the Twilio
# webhook returns immediately. See async_replies.md.
ASYNC_WHATSAPP_REPLY=0
# Number of background worker threads for async replies.
WHATSAPP_WORKERS=2

# Where a remote agent with "Allow callbacks" should send its callbacks
# (report_summary, set_conversation_privacy). Sent to the agent as cc_api_url in
# its run config, alongside a per-run token scoped to that one conversation.
# Blank: the agent uses its own CONVERSATIONAL_CARE_BASE_URL. See agent_tools.md.
# Example: AGENT_CALLBACK_URL=https://platform.conversational-care.ai
AGENT_CALLBACK_URL=

# Allow-list of hosts a remote agent may point at (SSRF guard; host only, no port).
# Use `host.docker.internal` to reach an agent published on the HOST machine when
# the app runs in Docker (e.g. an agent container exposed on the host at :8123).
AGENT_ALLOWED_HOSTS=host.docker.internal,localhost,127.0.0.1

# --- Sensei agents (optional; see agents.md → "Sensei agents") -------------
# Sensei is an external service that answers a client's questions about their
# own wearable / phone health data. Off by default: leave SENSEI_ENABLED at 0
# unless this installation actually has a Sensei endpoint to talk to. Everything
# below can also be set live in Settings → Sensei, which overrides these.
SENSEI_ENABLED=0
# Full endpoint, e.g. https://<function-app>.azurewebsites.net/api/send_message
SENSEI_API_URL=""
# Sent as the 'x-functions-key' header. A secret — do not commit a real one.
SENSEI_FUNCTION_KEY=""
# Keys the opaque per-client id sent to Sensei, so Sensei never sees a real
# client identifier. Any long random string; generate one with
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it makes every client log in to Sensei again, so set it once.
SENSEI_USER_ID_SECRET=""

# --- Message export (optional; see message_export.md) ----------------------
# Lets admins download every stored message as one CSV file (one row per
# message) from Settings → Export, e.g. for a study's behavioural analyses.
# Off by default: leave at 0 unless this installation needs it. Can also be
# switched live in Settings → Export, which overrides this.
MESSAGE_EXPORT_ENABLED=0
# Lets navigators download one conversation of their own clients (same CSV
# columns) from the download button on each conversation in the panel. A
# separate switch from the one above. Off by default; also in Settings → Export.
CONVERSATION_DOWNLOAD_ENABLED=0

# --- Conversation privacy (see conversation_privacy.md) ---
# Lets a client ask that one conversation not be readable by their link worker.
# The link worker still sees that it happened, when, and how many messages it
# held — not the content, the summary or the topic. Admins are unaffected, and a
# conversation that raised a self-harm alert stays readable. Off by default;
# also in Settings → Privacy. Turning it off later does not un-hide anything
# already hidden.
CONVERSATION_PRIVACY_ENABLED=0

# --- Link Worker v2 (see link_worker_v2.md) ---
# Which assistant the staff chat bubble runs. Off: the original Link Worker,
# unchanged. On: v2 (beta), which can also answer questions about a client's
# meetings, protocol answers and how they changed, alerts, notes and
# conversation summaries — only for clients the person could open on screen,
# with every record it reads logged. The matching client-record API endpoints
# exist only while this is on. Also in Settings → Agents.
LINK_WORKER_V2_ENABLED=0

# --- Link Worker on WhatsApp (see link_worker_whatsapp.md) ---
# Navigators link their own phone on their profile page and ask Link Worker v2
# by WhatsApp — about one client they load at a time. Needs LINK_WORKER_V2_ENABLED.
# Also in Settings → Agents.
LINK_WORKER_WHATSAPP_ENABLED=0
# ElevenLabs voice ID for replies to Portuguese voice notes (blank: v2's voice).
LINK_WORKER_VOICE_PT_BR=
# The same under TTS_PROVIDER=azure (blank: pt-BR-FranciscaNeural).
LINK_WORKER_AZURE_VOICE_PT_BR=

# --- Study enrolment (see participant_management.md) ---
# For a deployment running a research study: pre-enrol participants, issue each
# one a three-word access code, and take versioned consent on a public /join/
# page. Off by default, and invisible while off — no menu entry, no settings
# tab, nothing in the Django admin, and /join/ returns 404. Switching it off
# later hides the pages but deletes nothing. Also in Settings → Participants.
STUDY_ENROLMENT_ENABLED=0

# Whether a valid code plus consent creates the client straight away (1), or
# files it for an admin to admit by hand (0). On by default: a clinician issuing
# the code is the vouching.
ENROLMENT_AUTO_APPROVE=1

# Whether the join form asks for a date of birth. Off by default — a study that
# does not need one to identify participants should not be collecting it.
ENROLMENT_REQUIRE_DOB=0

# Words per access code (2–4). Three is short enough to read down a phone line
# and long enough that guessing is hopeless.
ENROLMENT_CODE_WORDS=3

# Wrong access codes one address may try per hour before it is locked out. This,
# not the size of the word list, is what actually stops a script.
ENROLMENT_CODE_ATTEMPT_LIMIT=10

# --- Background jobs (see background_jobs.md) ---
# Transcription and meeting mixdown run on a database-backed queue, worked by
# the `worker` compose service. JOBS_RUNNER=thread runs jobs inside the web
# process instead (no extra container; work pauses while web is restarting).
JOBS_RUNNER=worker
JOBS_EAGER=0

# --- Online meetings (optional; see online_meetings.md) ---
# The app is installed unless MEETINGS_APP=0; the feature itself is OFF until
# switched on here or in Settings → Online meetings. The media server and the
# agents only run with `--profile meetings` (docker-compose.meetings.yml), and
# even then stay parked (~2 MB each) while the feature is off.
MEETINGS_APP=1
ONLINE_MEETINGS_ENABLED=
# 0 runs the media server and agents whenever their containers are up, ignoring
# the switch. How often (seconds) they check the switch.
MEETINGS_GATE=1
MEETINGS_GATE_POLL=60
# What browsers connect to (dev: ws://localhost:7880; server: wss://lk.example.org)
LIVEKIT_URL=
# How the web app reaches LiveKit's API inside compose
LIVEKIT_API_URL=http://livekit:7880
# Any long random strings; LiveKit, the web app and the agents all read these.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The IP browsers reach this machine's media port on (127.0.0.1 for local
# testing, your LAN IP to test from a phone, the public IP on a server).
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_USE_EXTERNAL_IP=false
LIVEKIT_TURN_ENABLED=false
# Shared secret the meeting agents present to the web app's internal API.
MEETINGS_SERVICE_KEY=
# Base for links sent to clients (falls back to AGENT_CALLBACK_URL).
MEETINGS_PUBLIC_BASE_URL=
# Signs client links. Blank derives one from DJANGO_SECRET_KEY.
MEETING_LINK_KEY=
# For the `edge` profile (Caddy, automatic HTTPS):
APP_DOMAIN=
LIVEKIT_DOMAIN=
# Denoising for what the agents hear and record (none bundled yet; see
# meeting_agents/cc_agents/processors.py).
CC_DENOISE=
